<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/cor" elementFormDefault="qualified" attributeFormDefault="unqualified"
  xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:cor="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/cor"
  xmlns:bus="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/bus"
  xmlns:lnk="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/lnk"
>
  <import namespace="http://www.xbrl.org/2003/instance" schemaLocation="http://www.xbrl.org/2003/xbrl-instance-2003-12-31.xsd"/>
  <include schemaLocation="../../cor/cor-2026-12-31.xsd"/>
  <import namespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/bus" schemaLocation="bus-content-2026-12-31.xsd"/>
  <import namespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/lnk" schemaLocation="lnk-content-2026-12-31.xsd"/>
  <!-- structural ComplexType supplied for the Palette module -->
  <complexType name="documentInformationComplexType">
    <sequence>
      <element ref="cor:documentType"/>
      <element ref="cor:auditNumber"/>
      <element ref="cor:revisesAuditNumber" minOccurs="0"/>
      <element ref="cor:actionToTakeWithPreviousData" minOccurs="0"/>
      <element ref="cor:language" minOccurs="0"/>
      <element ref="cor:creationDate" minOccurs="0"/>
      <element ref="cor:creator" minOccurs="0"/>
      <element ref="cor:documentComment" minOccurs="0"/>
      <element ref="cor:periodCoveredStart" minOccurs="0"/>
      <element ref="cor:periodCoveredEnd" minOccurs="0"/>
      <element ref="cor:periodCount" minOccurs="0"/>
      <element ref="cor:periodUnit" minOccurs="0"/>
      <element ref="cor:periodUnitDescription" minOccurs="0"/>
      <element ref="cor:sourceApplication" minOccurs="0"/>
      <element ref="cor:targetApplication" minOccurs="0"/>
      <element ref="cor:defaultCurrency" minOccurs="0"/>
      <element ref="lnk:summaryReportingTaxonomies" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="entityPartyComplexType">
    <sequence>
      <element ref="cor:partyName" minOccurs="0"/>
      <element ref="cor:partyId" minOccurs="0"/>
      <element ref="cor:partyRole" minOccurs="0"/>
      <element ref="cor:partyBusinessDescription" minOccurs="0"/>
      <element ref="bus:entityPartyPhone" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyFax" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyEmail" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:organizationIdentifier" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyAddress" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyWebSite" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyContact" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="cor:defaultAccountingMethodPurpose" minOccurs="0"/>
      <element ref="cor:defaultAccountingMethodPurposeDescription" minOccurs="0"/>
      <element ref="cor:fiscalYearStart" minOccurs="0"/>
      <element ref="cor:fiscalYearEnd" minOccurs="0"/>
      <element ref="bus:specifiedAccountingMethodStructure" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:assignedAccountant" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:specifiedReportingCalendar" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="documentComplexType">
    <sequence>
      <element ref="cor:documentNumber"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="detailXbrlComplexType">
    <sequence>
      <element ref="cor:xbrlAllocation" minOccurs="0"/>
      <element ref="cor:xbrlSummaryReportingElement" minOccurs="0"/>
      <element ref="cor:xbrlDetailMatchingElement" minOccurs="0"/>
      <element ref="cor:xbrlSummaryTuplePath" minOccurs="0"/>
      <element ref="cor:xbrlDetailedContentFilter" minOccurs="0"/>
      <element ref="cor:xbrlReportingDateSelector" minOccurs="0"/>
      <element ref="cor:xbrlSummaryOperator" minOccurs="0"/>
      <element ref="cor:xbrlSummaryUnitNumerator"/>
      <element ref="cor:xbrlSummaryUnitDenominator" minOccurs="0"/>
      <element ref="cor:xbrlSummaryReportingTaxonomyIdReference" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
</schema>
