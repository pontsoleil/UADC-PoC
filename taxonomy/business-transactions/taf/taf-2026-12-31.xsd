<schema targetNamespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/taf" attributeFormDefault="unqualified" elementFormDefault="qualified"
  xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:link="http://www.xbrl.org/2003/linkbase"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:xbrldt="http://xbrl.org/2005/xbrldt"
  xmlns:gen="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/gen"
  xmlns:taf="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/taf"
>
  <import namespace="http://www.xbrl.org/2003/instance" schemaLocation="http://www.xbrl.org/2003/xbrl-instance-2003-12-31.xsd"/>
  <import namespace="http://www.xbrl.org/2003/linkbase" schemaLocation="http://www.xbrl.org/2003/xbrl-linkbase-2003-12-31.xsd"/>
  <import namespace="http://xbrl.org/2005/xbrldt" schemaLocation="http://www.xbrl.org/2005/xbrldt-2005.xsd"/>
  <import namespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/gen" schemaLocation="../gen/gl-gen-2026-12-31.xsd"/>
  <!-- reusable item type -->
  <complexType name="originatingDocumentTypeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="originatingDocumentNumberItemType">
    <simpleContent>
      <restriction base="xbrli:stringItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="originatingDocumentDateItemType">
    <simpleContent>
      <restriction base="xbrli:dateItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="originatingDocumentIdentifierTypeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="originatingDocumentIdentifierCodeItemType">
    <simpleContent>
      <restriction base="xbrli:stringItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="originatingDocumentIdentifierTaxCodeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <!-- reusable global element declaration -->
  <element name="originatingDocument" id="taf_originatingDocument" type="taf:originatingDocumentComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="originatingDocumentType" id="taf_originatingDocumentType" type="taf:originatingDocumentTypeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="originatingDocumentNumber" id="taf_originatingDocumentNumber" type="taf:originatingDocumentNumberItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="originatingDocumentDate" id="taf_originatingDocumentDate" type="taf:originatingDocumentDateItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="originatingDocumentIdentifierType" id="taf_originatingDocumentIdentifierType" type="taf:originatingDocumentIdentifierTypeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="originatingDocumentIdentifierCode" id="taf_originatingDocumentIdentifierCode" type="taf:originatingDocumentIdentifierCodeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="originatingDocumentIdentifierTaxCode" id="taf_originatingDocumentIdentifierTaxCode" type="taf:originatingDocumentIdentifierTaxCodeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
</schema>
