  <complexType name="documentSummaryReportingTaxonomiesComplexType">
    <sequence>
      <element ref="lnk:documentSummaryReportingTaxonomyId" minOccurs="0"/>
      <element ref="lnk:documentSummaryReportingTaxonomySchemaReferenceHrefAttribute" minOccurs="0"/>
