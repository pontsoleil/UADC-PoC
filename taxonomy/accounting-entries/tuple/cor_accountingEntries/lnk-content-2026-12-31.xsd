<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/lnk" elementFormDefault="qualified" attributeFormDefault="unqualified"
  xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:lnk="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/lnk"
