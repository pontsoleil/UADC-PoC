  <element name="originatingDocumentIdentifierTaxCode" id="taf_originatingDocumentIdentifierTaxCode" type="taf:originatingDocumentIdentifierTaxCodeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
