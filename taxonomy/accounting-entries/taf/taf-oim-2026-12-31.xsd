<schema targetNamespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/taf" attributeFormDefault="unqualified" elementFormDefault="qualified"
  xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:taf="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/taf"
  xmlns:gen="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/gen">
  <import namespace="http://www.xbrl.org/2003/instance" schemaLocation="http://www.xbrl.org/2003/xbrl-instance-2003-12-31.xsd"/>
  <import namespace="https://www.xbrl.or.jp/taxonomy/xbrl-gl-next/gen" schemaLocation="../gen/gl-gen-2026-12-31.xsd"/>
  <!-- reusable OIM Attribute item type -->
  <complexType name="documentTypeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="documentNumberItemType">
    <simpleContent>
      <restriction base="xbrli:stringItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="documentDateItemType">
    <simpleContent>
      <restriction base="xbrli:dateItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="documentIdentifierTypeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="documentIdentifierCodeItemType">
    <simpleContent>
      <restriction base="xbrli:stringItemType"/>
    </simpleContent>
  </complexType>
  <complexType name="documentIdentifierTaxCodeItemType">
    <simpleContent>
      <restriction base="xbrli:tokenItemType"/>
    </simpleContent>
  </complexType>
  <!-- reusable OIM Attribute item element -->
  <element name="documentType" id="taf_documentType" type="taf:documentTypeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="documentNumber" id="taf_documentNumber" type="taf:documentNumberItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="documentDate" id="taf_documentDate" type="taf:documentDateItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="documentIdentifierType" id="taf_documentIdentifierType" type="taf:documentIdentifierTypeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="documentIdentifierCode" id="taf_documentIdentifierCode" type="taf:documentIdentifierCodeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <element name="documentIdentifierTaxCode" id="taf_documentIdentifierTaxCode" type="taf:documentIdentifierTaxCodeItemType" substitutionGroup="xbrli:item" nillable="true" xbrli:periodType="instant"/>
  <!-- reusable OIM Class primary-item anchor -->
  <element name="p_taf_originatingDocument" id="p_taf_originatingDocument" substitutionGroup="xbrli:item" type="xbrli:stringItemType" nillable="true" xbrli:periodType="instant"/>
</schema>
